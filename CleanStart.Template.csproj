<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageVersion>0.1.0</PackageVersion>
    <PackageId>CleanStart.Templates</PackageId>
    <Title>CleanStart - Clean Architecture Template</Title>
    <Authors>Michael Sadradze</Authors>
    <Description>A dotnet new template for Clean Architecture</Description>
    <PackageTags>dotnet-new;templates;clean-architecture;aspnetcore</PackageTags>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>

    <NoBuild>true</NoBuild>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates/**" Exclude="**/bin/**;**/obj/**" />
  </ItemGroup>

</Project>
